{
  "version": "1.0",
  "ageBand": "PB_TODDLER",
  "ageMonthsRange": [
    12,
    36
  ],
  "label": "toddler (1-3 years)",
  "narrativeConstraints": {
    "spreadCount": 13,
    "narrativeTense": "present",
    "wordsPerSpread": {
      "min": 5,
      "max": 15,
      "target": 10
    },
    "totalBookWords": {
      "min": 65,
      "max": 195,
      "target": 130
    },
    "linesPerSpread": {
      "min": 2,
      "max": 4,
      "target": 4
    },
    "syllablesPerLine": {
      "min": 3,
      "max": 7,
      "target": 5
    },
    "antagonistPolicy": "NO antagonist — obstacles come from nature, weather, time, distance, or uncertainty only. Never a character who opposes the child.",
    "rhymeScheme": "AABB",
    "rhymeStrictness": "perfect_rhyme_required_imperfect_eye_rhymes_banned",
    "allowedForms": [
      "rhymed_verse",
      "rhythmic_prose"
    ],
    "dialogueDensity": "very_low",
    "conflictIntensityMax": 0.2,
    "repetitionDensity": "high_intentional_refrain_ok",
    "pageTurnHookStyle": "soft_anticipation",
    "abstractionLevel": "concrete_sensory",
    "memoryLoadPerPage": "single_image_per_spread",
    "namedCharacterCap": 3,
    "newConceptIntroductionsPerBookMax": 2
  },
  "vocabularyConstraints": {
    "maxWordLengthChars": 8,
    "maxAvgSentenceWords": 9,
    "bannedWordCategories": [
      "abstract_emotion_nouns",
      "compound_metaphors"
    ],
    "bannedPhrasesCategories": [
      "filler_meter_phrases",
      "moralizing_phrases"
    ],
    "preferredRegister": "warm_concrete_sensory"
  },
  "illustrationConstraints": {
    "sceneDensity": "low_one_focal_point",
    "backgroundComplexity": "soft_blurred",
    "facialExpressionRange": "calm_to_warm_smile",
    "noScaryImagery": true
  }
}
