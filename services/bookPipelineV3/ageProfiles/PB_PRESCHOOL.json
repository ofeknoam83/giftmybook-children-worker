{
  "version": "1.0",
  "ageBand": "PB_PRESCHOOL",
  "ageMonthsRange": [
    36,
    60
  ],
  "label": "preschool (3-4 years)",
  "narrativeConstraints": {
    "spreadCount": 13,
    "narrativeTense": "past",
    "wordsPerSpread": {
      "min": 8,
      "max": 15,
      "target": 12
    },
    "totalBookWords": {
      "min": 105,
      "max": 195,
      "target": 155
    },
    "linesPerSpread": {
      "min": 2,
      "max": 4,
      "target": 3
    },
    "syllablesPerLine": {
      "min": 4,
      "max": 9,
      "target": 6
    },
    "antagonistPolicy": "NO antagonist — obstacles come from nature, weather, time, distance, or uncertainty only. Never a character who opposes the child.",
    "rhymeScheme": "AABB",
    "rhymeStrictness": "perfect_rhyme_required_imperfect_eye_rhymes_banned",
    "allowedForms": [
      "rhymed_verse",
      "rhythmic_prose",
      "sparse_lyric"
    ],
    "dialogueDensity": "low",
    "conflictIntensityMax": 0.4,
    "repetitionDensity": "moderate_refrain_ok",
    "pageTurnHookStyle": "mild_suspense",
    "abstractionLevel": "concrete_with_named_emotions",
    "memoryLoadPerPage": "one_or_two_threads",
    "namedCharacterCap": 4,
    "newConceptIntroductionsPerBookMax": 3
  },
  "vocabularyConstraints": {
    "maxWordLengthChars": 10,
    "maxAvgSentenceWords": 11,
    "bannedWordCategories": [
      "compound_metaphors_excessive"
    ],
    "bannedPhrasesCategories": [
      "filler_meter_phrases",
      "moralizing_phrases"
    ],
    "preferredRegister": "warm_concrete_with_emotion_words"
  },
  "illustrationConstraints": {
    "sceneDensity": "medium_one_or_two_focal_points",
    "backgroundComplexity": "moderate",
    "facialExpressionRange": "full_warm_palette",
    "noScaryImagery": true
  }
}
