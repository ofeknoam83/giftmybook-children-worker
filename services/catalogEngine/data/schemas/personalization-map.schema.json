{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giftmybook.com/schemas/writer/v1.3/personalization-map.schema.json",
  "title": "GiftMyBook per-book personalization map V1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_version", "book_id", "targets", "detail_repeat_limit", "slots"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "map_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_moments", "ideal_moments", "max_moments", "min_details", "max_details"],
      "properties": {
        "min_moments": {"type": "integer", "minimum": 0, "maximum": 6},
        "ideal_moments": {"type": "integer", "minimum": 0, "maximum": 6},
        "max_moments": {"type": "integer", "minimum": 0, "maximum": 6},
        "min_details": {"type": "integer", "minimum": 0, "maximum": 4},
        "max_details": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "detail_repeat_limit": {"type": "integer", "minimum": 1, "maximum": 3},
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/slot"}
    }
  },
  "$defs": {
    "momentType": {
      "enum": ["object_presence", "object_callback", "habit_behavior", "trait_behavior", "interest_reaction", "interest_comparison", "place_reference", "food_celebration", "closing_callback", "visual_prop"]
    },
    "profileField": {
      "enum": ["object", "interests", "activities", "food", "place", "habit", "trait"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "spread", "allowed_moment_types", "allowed_profile_fields", "priority", "max_uses", "instruction", "visual_alignment"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^s(?:0[1-9]|1[0-2])_[a-z0-9_]+$"},
        "spread": {"type": "integer", "minimum": 1, "maximum": 12},
        "allowed_moment_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/momentType"}},
        "allowed_profile_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/profileField"}},
        "priority": {"enum": ["preferred", "optional"]},
        "max_uses": {"const": 1},
        "requires_prior_detail_use": {"type": "boolean", "default": false},
        "instruction": {"type": "string", "minLength": 20, "maxLength": 500},
        "visual_alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["none", "optional", "required_if_used"]},
            "visual_slot_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "required_if_used"}}}, "then": {"required": ["visual_slot_id"]}},
            {"if": {"properties": {"mode": {"const": "none"}}}, "then": {"not": {"required": ["visual_slot_id"]}}}
          ]
        }
      }
    }
  }
}
