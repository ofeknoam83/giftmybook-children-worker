{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giftmybook.com/schemas/audioScript.schema.json",
  "title": "Audio script (ab-1)",
  "description": "The schema-validated performance plan the audiobook engine builds from pinned inputs (docs/AUDIOBOOK_V2_PLAN.md §4.1). Every string in `lines[].text` is manuscript text verbatim (or a fixed template line); direction is metadata from closed vocabularies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "language",
    "band",
    "castHash",
    "segments",
    "hash"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^ab-[0-9]+$"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "he"
      ]
    },
    "band": {
      "type": "string",
      "enum": [
        "1-3",
        "4-5",
        "6-7",
        "8-10"
      ]
    },
    "castHash": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64
    },
    "director": {
      "type": "string",
      "enum": [
        "table",
        "llm"
      ]
    },
    "hash": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "kind",
          "spread",
          "lines",
          "expectedWords",
          "expectedSeconds"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "kind": {
            "type": "string",
            "enum": [
              "intro",
              "dedication",
              "spread",
              "outro"
            ]
          },
          "spread": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 12
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "text",
                "speaker",
                "direction",
                "isRefrain",
                "pauseAfterMs"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 39
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "speaker": {
                  "type": "string",
                  "enum": [
                    "narrator",
                    "companion"
                  ]
                },
                "direction": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "emotion",
                    "intensity",
                    "pace",
                    "shape"
                  ],
                  "properties": {
                    "emotion": {
                      "type": "string",
                      "enum": [
                        "joy",
                        "wonder",
                        "curiosity",
                        "determination",
                        "worry",
                        "calm",
                        "surprise",
                        "pride",
                        "tenderness",
                        "silly"
                      ]
                    },
                    "intensity": {
                      "type": "string",
                      "enum": [
                        "soft",
                        "clear",
                        "big"
                      ]
                    },
                    "pace": {
                      "type": "string",
                      "enum": [
                        "slow",
                        "even",
                        "brisk"
                      ]
                    },
                    "shape": {
                      "type": "string",
                      "enum": [
                        "statement",
                        "question",
                        "exclaim",
                        "trail"
                      ]
                    }
                  }
                },
                "isRefrain": {
                  "type": "boolean"
                },
                "pauseAfterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4000
                }
              }
            }
          },
          "expectedWords": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400
          },
          "expectedSeconds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "music": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "cue"
            ],
            "properties": {
              "cue": {
                "type": "string",
                "enum": [
                  "theme_intro",
                  "calm",
                  "playful",
                  "wonder",
                  "tender",
                  "gentle_tension",
                  "triumph",
                  "lullaby_outro"
                ]
              },
              "change": {
                "type": "boolean"
              },
              "gainDb": {
                "type": "number",
                "minimum": -60,
                "maximum": 0
              },
              "motif": {
                "type": "boolean"
              }
            }
          },
          "ambience": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "cueId",
              "gainDb"
            ],
            "properties": {
              "cueId": {
                "type": "string",
                "pattern": "^amb_[a-z_]+$"
              },
              "gainDb": {
                "type": "number",
                "minimum": -60,
                "maximum": 0
              }
            }
          },
          "sfx": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cueId",
                "anchorLine",
                "placement",
                "gainDb",
                "source"
              ],
              "properties": {
                "cueId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "anchorLine": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 39
                },
                "placement": {
                  "type": "string",
                  "enum": [
                    "after",
                    "under"
                  ]
                },
                "gainDb": {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 0
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "evidence",
                    "beat",
                    "text",
                    "director"
                  ]
                },
                "seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            }
          }
        }
      }
    },
    "pageTurn": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "cueId",
        "gainDb",
        "seconds"
      ],
      "properties": {
        "cueId": {
          "type": "string"
        },
        "gainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "advisories": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
